{
    "name": "ugarit/folio",
    "description": "Page based routing for Ugarit.",
    "keywords": [
        "ugarit",
        "routing"
    ],
    "homepage": "https://github.com/ugarit/folio",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/ugarit/folio/issues",
        "source": "https://github.com/ugarit/folio"
    },
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "heritage/container": "^1.00.00",
        "heritage/console": "^1.00.00",
        "heritage/contracts": "^1.00.00",
        "heritage/filesystem": "^1.00.00",
        "heritage/pipeline": "^1.00.00",
        "heritage/routing": "^1.00.00",
        "heritage/support": "^1.00.00",
        "heritage/view": "^1.00.00",
        "spatie/once": "^3.1",
        "symfony/console": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.36|^9.15|^10.8|^11.0",
        "pestphp/pest": "^2.5|^3.0|^4.0",
        "phpstan/phpstan": "^1.10|^2.1"
    },
    "autoload": {
        "psr-4": {
            "Ugarit\\Folio\\": "src/"
        },
        "files": [
            "functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app",
            "Workbench\\Database\\": "workbench/database"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "ugarit": {
            "providers": [
                "Ugarit\\Folio\\FolioServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "block-insecure": false
        },
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php ./vendor/bin/testbench package:create-sqlite-db",
            "@php ./vendor/bin/testbench migrate:refresh"
        ],
        "start": [
            "@composer run prepare",
            "@php ./vendor/bin/testbench serve"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.00.00"
}
